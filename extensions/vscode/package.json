{
  "name": "nestlone-vscode",
  "displayName": "Nestlone",
  "description": "Official Nestlone VS Code integration scaffold for local runtime attach and terminal launch.",
  "version": "0.8.53",
  "publisher": "nestlone",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bdugsj/nestlone.git",
    "directory": "extensions/vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:nestlone.openTerminal",
    "onCommand:nestlone.startRuntime",
    "onCommand:nestlone.checkRuntime",
    "onCommand:nestlone.refreshAgentView",
    "onCommand:nestlone.refreshSnapshots",
    "onCommand:nestlone.openRuntimeDocs",
    "onView:nestlone.runtimeStatus"
  ],
  "main": "./out/extension.js",
  "files": [
    "out",
    "media",
    "README.md",
    "LICENSE"
  ],
  "contributes": {
    "commands": [
      {
        "command": "nestlone.openTerminal",
        "title": "Nestlone: Open Terminal"
      },
      {
        "command": "nestlone.startRuntime",
        "title": "Nestlone: Start Local Runtime"
      },
      {
        "command": "nestlone.checkRuntime",
        "title": "Nestlone: Check Runtime"
      },
      {
        "command": "nestlone.refreshAgentView",
        "title": "Nestlone: Refresh Agent View"
      },
      {
        "command": "nestlone.refreshSnapshots",
        "title": "Nestlone: Refresh Restore Points"
      },
      {
        "command": "nestlone.openRuntimeDocs",
        "title": "Nestlone: Open Runtime API Docs"
      }
    ],
    "configuration": {
      "title": "Nestlone",
      "properties": {
        "nestlone.commandPath": {
          "type": "string",
          "default": "nestlone",
          "description": "Command or absolute path used to launch Nestlone."
        },
        "nestlone.runtimeHost": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Local host used for Nestlone runtime attach checks."
        },
        "nestlone.runtimePort": {
          "type": "number",
          "default": 7878,
          "minimum": 1,
          "maximum": 65535,
          "description": "Local port used for Nestlone runtime attach checks."
        },
        "nestlone.runtimeToken": {
          "type": "string",
          "default": "",
          "description": "Optional bearer token for authenticated runtime endpoints."
        },
        "nestlone.agentViewRefreshIntervalSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 0,
          "maximum": 300,
          "description": "Seconds between read-only Agent View refreshes. Set to 0 to disable automatic refresh."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nestlone",
          "title": "Nestlone",
          "icon": "media/nestlone.svg"
        }
      ]
    },
    "views": {
      "nestlone": [
        {
          "type": "webview",
          "id": "nestlone.runtimeStatus",
          "name": "Agent View"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "check": "npm run compile",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.19.27",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.7.0",
    "typescript": "^5.9.3"
  }
}
