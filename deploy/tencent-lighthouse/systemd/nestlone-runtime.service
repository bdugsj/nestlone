[Unit]
Description=Nestlone Runtime API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=nestlone
Group=nestlone
WorkingDirectory=/opt/nestlone
# Legacy /etc/deepseek is loaded first for old installs; /etc/nestlone wins.
EnvironmentFile=-/etc/deepseek/runtime.env
EnvironmentFile=-/etc/nestlone/runtime.env
ExecStart=/bin/sh -lc 'exec /home/nestlone/.cargo/bin/nestlone serve --http --host 127.0.0.1 --port "${CODEWHALE_RUNTIME_PORT:-${DEEPSEEK_RUNTIME_PORT:-7878}}" --workers "${CODEWHALE_RUNTIME_WORKERS:-${DEEPSEEK_RUNTIME_WORKERS:-2}}" --auth-token "${CODEWHALE_RUNTIME_TOKEN:-${DEEPSEEK_RUNTIME_TOKEN}}"'
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/nestlone/.nestlone /home/nestlone/.deepseek /opt/nestlone

[Install]
WantedBy=multi-user.target
