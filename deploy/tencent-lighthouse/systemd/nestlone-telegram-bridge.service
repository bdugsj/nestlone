[Unit]
Description=Nestlone Telegram Phone Bridge
Wants=network-online.target nestlone-runtime.service
After=network-online.target nestlone-runtime.service

[Service]
Type=simple
User=nestlone
Group=nestlone
WorkingDirectory=/opt/nestlone/telegram-bridge
# Legacy /etc/deepseek is loaded first for old installs; /etc/nestlone wins.
EnvironmentFile=-/etc/deepseek/telegram-bridge.env
EnvironmentFile=-/etc/nestlone/telegram-bridge.env
ExecStart=/usr/bin/node /opt/nestlone/telegram-bridge/src/index.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/nestlone-telegram-bridge

[Install]
WantedBy=multi-user.target
