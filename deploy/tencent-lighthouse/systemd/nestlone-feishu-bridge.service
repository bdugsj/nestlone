[Unit]
Description=Nestlone Feishu/Lark Phone Bridge
Wants=network-online.target nestlone-runtime.service
After=network-online.target nestlone-runtime.service

[Service]
Type=simple
User=nestlone
Group=nestlone
WorkingDirectory=/opt/nestlone/bridge
# Legacy /etc/deepseek is loaded first for old installs; /etc/nestlone wins.
EnvironmentFile=-/etc/deepseek/feishu-bridge.env
EnvironmentFile=-/etc/nestlone/feishu-bridge.env
ExecStart=/usr/bin/node /opt/nestlone/bridge/src/index.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/nestlone-feishu-bridge

[Install]
WantedBy=multi-user.target
